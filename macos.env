# Source before building/running on macOS (arm64): `source macos.env`
# Apple clang 15 lacks C++20 parenthesized aggregate init used by the engine; Homebrew GCC has it.
# The engine relies on a transitive <climits>; force-include it without editing engine files.
export CXX="g++-16 -include climits"
# torch bundles libomp; make LightGBM load the same copy (one OpenMP runtime per process).
export DYLD_LIBRARY_PATH="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/.venv/lib/python3.12/site-packages/torch/lib"
